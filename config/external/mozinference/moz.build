# The mozinference library contains ML inference libraries, that are typically
# compiled statically with more recent instruction sets, and do no do dynamic
# dispatch (unfortunately). It is loaded dynamically as needed.
#
GeckoSharedLibrary("mozinference")
SHARED_LIBRARY_NAME = "mozinference"

# Export only the symbols we need for dynamic linking
if CONFIG["OS_TARGET"] != "Android":
    # The WebNN engine functions generated from WebNN.webidl are appended to
    # mozinference.symbols.
    symbols_file = (
        "mozinference.def"
        if CONFIG["OS_TARGET"] == "WINNT"
        else "libmozinference.symbols"
    )
    GENERATED_FILES += [symbols_file]
    GENERATED_FILES[
        symbols_file
    ].script = "/dom/webnn/codegen/webnn_codegen.py:mozinference_symbols"
    GENERATED_FILES[symbols_file].inputs = [
        "mozinference.symbols",
        "/dom/webidl/WebNN.webidl",
    ]
    SYMBOLS_FILE = "!" + symbols_file
    EXTRA_LINK_DEPS += ["!" + symbols_file]

    USE_LIBS += ["webnn_engine"]
else:
    SYMBOLS_FILE = "mozinference.symbols"

if CONFIG["OS_ARCH"] == "Darwin":
    OS_LIBS += [
        "-framework CoreML",
        "-framework Foundation",
        "c++",
        "objc",
    ]
